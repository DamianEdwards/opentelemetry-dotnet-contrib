<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>$(TargetFrameworksForLibraries)</TargetFrameworks>
    <Description>An OpenTelemetry .NET exporter that exports traces, metrics and logs to Azure Data Explorer (Kusto).</Description>
    <PackageTags>$(PackageTags);AzureDataExplorer;ADX;Kusto;Fabric</PackageTags>
    <MinVerTagPrefix>Exporter.AzureDataExplorer-</MinVerTagPrefix>
    <!-- Kusto.Cloud.Platform publicly exposes a polyfill of CallerArgumentExpressionAttribute
    which conflicts with the one in the linked Guard.cs on older target frameworks. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- Do not run Package Baseline Validation as this package has never released a stable version.
  Remove this property once we have released a stable version and add PackageValidationBaselineVersion property. -->
  <PropertyGroup>
    <DisablePackageBaselineValidation>true</DisablePackageBaselineValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Microsoft.Azure.Kusto.Ingest" />
    <PackageReference Include="OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(RepoRoot)\src\Shared\AssemblyVersionExtensions.cs" Link="Includes\AssemblyVersionExtensions.cs" />
    <Compile Include="$(RepoRoot)\src\Shared\ExceptionExtensions.cs" Link="Includes\ExceptionExtensions.cs" />
    <Compile Include="$(RepoRoot)\src\Shared\Guard.cs" Link="Includes\Guard.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenTelemetry.Exporter.AzureDataExplorer.Tests" PublicKey="$(StrongNamePublicKey)" />
  </ItemGroup>

</Project>
